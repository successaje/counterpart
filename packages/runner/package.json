{
  "name": "@counterpart/runner",
  "version": "0.1.0",
  "description": "The local evidence runner: menu, approval gate, sandbox, redaction, ledger and local API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@counterpart/protocol": "workspace:*",
    "@hono/node-server": "^1.19.18",
    "hono": "^4.13.16",
    "tinyglobby": "^0.2.14",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/successaje/counterpart.git",
    "directory": "packages/runner"
  },
  "homepage": "https://github.com/successaje/counterpart#readme",
  "publishConfig": {
    "access": "public"
  }
}
