{
  "name": "@counterpart/protocol",
  "version": "0.1.0",
  "description": "The Counterpart evidence protocol: requests, records, releases, case states, redaction and evidence cards.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/successaje/counterpart.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/successaje/counterpart#readme",
  "publishConfig": {
    "access": "public"
  }
}
