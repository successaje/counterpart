{
  "name": "counterpart",
  "version": "0.1.0",
  "description": "Support where both sides bring an agent. The counterpart CLI and MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "counterpart": "./bin/counterpart.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@counterpart/protocol": "workspace:*",
    "@counterpart/runner": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
