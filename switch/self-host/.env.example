# A self-hosted Switch for a Counterpart support room.
#
# `./up.sh` copies this file to `.env` once, fills every blank secret with a
# fresh random value, and prints the Gateway sign-in. Edit `.env` afterwards,
# never this file. The variable names are Switch's own
# (https://github.com/sandbox-quantum/switch/blob/main/.env.example); only
# the ones this deployment needs are here.

# ── The stack ────────────────────────────────────────────────────────────────
# The one version every image and the compose file are pinned to. up.sh
# downloads the compose file published at this tag and checks its hash.
SWITCH_VERSION=0.31.0
SWITCH_REGISTRY=ghcr.io
SWITCH_IMAGE_NAMESPACE=sandbox-quantum
# collab adds the bundled Mattermost, so the demo needs no Discord bot;
# gateway adds the operator dashboard on :3000.
COMPOSE_PROFILES=collab,gateway

# ── Addresses ────────────────────────────────────────────────────────────────
# Loopback by default. Set 0.0.0.0 only behind a reverse proxy or firewall:
# the Gateway sign-in is the only lock on the API.
SWITCH_BIND_ADDR=127.0.0.1
API_HOST_PORT=8000
GATEWAY_HOST_PORT=3000
MATTERMOST_HOST_PORT=8065
POSTGRES_HOST_PORT=5432
# The public address of the Switch API (scheme and host, no path). Despite the
# name it is the API, not the Gateway: "Open in Switch Console" links and the
# Add machine dialog are built from it.
GATEWAY_PUBLIC_URL=http://localhost:8000
# Where Gateway links point.
FRONTEND_BASE_URL=http://localhost:3000
# Private hosts Switch may reach at a URL someone supplied; the compose file
# always adds the bundled `mattermost`.
OUTBOUND_ALLOWED_PRIVATE_HOSTS=localhost

# ── Identity ─────────────────────────────────────────────────────────────────
# The server half of every id. Set once; it cannot change after the first run.
ID_SERVER_NAME=localhost

# ── Secrets (blank on purpose; up.sh generates them) ─────────────────────────
# Master keys, "<id>:<secret>" comma-separated, current first, 32+ characters.
# Losing them loses every stored credential (bot tokens, registration keys).
SECRET_KEYS=
# Bootstrap key for registering agents from outside Switch Console. Not shared.
AGENT_REGISTRATION_TOKEN=
# The first Gateway admin, created on the first start only.
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=
# Database roles: the owner runs migrations, the runtime role serves requests.
DB_USER=switch_app
DB_PASSWORD=
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=
DB_NAME=switch
# The bundled Mattermost: an admin for Switch, and one person to sign in as.
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=switch
MATTERMOST_USER=user
MATTERMOST_USER_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# Managed agents (version 2 templates, machines, controllers). Off for the
# demo: both agents run where their owners run them, from Switch Console.
# Turning it on needs CONTROLLER_TOKEN_SECRET (32+ characters).
FEATURE_FLAGS_ENABLED=
CONTROLLER_TOKEN_SECRET=
# Anonymous usage counts. Off.
TELEMETRY_ENABLED=false
TELEMETRY_ENVIRONMENT=local
