{
  "name": "counterpart-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Support where both sides bring an agent.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "dev:desk-server": "node scripts/desk-dev-server.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:publish": "pnpm -r --filter @counterpart/protocol --filter @counterpart/runner --filter @counterpart/desk --filter counterpart publish --access public --no-git-checks",
    "version:set": "node scripts/version-set.mjs",
    "demo": "pnpm --filter @counterpart/desk build && node scripts/desk-dev-server.mjs",
    "og:render": "node scripts/og/render.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@counterpart/runner": "workspace:*",
    "yaml": "^2.9.1",
    "tinyglobby": "^0.2.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/successaje/counterpart.git"
  },
  "homepage": "https://github.com/successaje/counterpart#readme",
  "bugs": {
    "url": "https://github.com/successaje/counterpart/issues"
  }
}
