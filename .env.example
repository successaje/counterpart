# Counterpart runner / CLI
# Port the local server prefers. It falls back to a free port when busy.
COUNTERPART_PORT=4747
# Name the reporter's agent uses in the ledger (default: dev-agent).
COUNTERPART_AGENT_NAME=dev-agent
# Set to 1 to stop `counterpart desk` from opening a browser.
COUNTERPART_NO_OPEN=
# Point at a built Desk when it is not installed as @counterpart/desk.
COUNTERPART_DESK_DIR=
